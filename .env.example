# Read-only analytical inputs. Defaults to ../../location_selection/data/processed.
RLE_ANALYSIS_DATA_DIR=
# Optional read-only raw source directory for enumeration validation workflows.
RLE_RAW_DATA_DIR=
# Local-only server defaults.
RLE_HOST=127.0.0.1
RLE_PORT=8787
# Phase 4 production hooks.
RLE_SCENARIO_DB=data/private/scenarios.sqlite3
RLE_REQUIRE_AUTH=0
RLE_PRIVATE_AUTH_TOKEN=
RLE_LOG_LEVEL=INFO
RLE_SENTRY_DSN=
RLE_SENTRY_TRACES_SAMPLE_RATE=0
