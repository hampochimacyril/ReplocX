.DS_Store
__pycache__/
*.py[cod]
.env
.env.*
.venv/
.tools/
node_modules/
dist/
coverage/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
blob-report/
playwright-report/
test-results/
data/analysis_manifest.json
data/private/
