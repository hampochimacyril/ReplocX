# Credential-bearing documents kept locally; never commit.
*.docx
~$*.docx

# Pipeline intermediates (regenerated by `python3 -m pipeline.run`).
# pipeline/out/ is the committed, reproducible app-ready dataset.
pipeline/work/
pipeline/cache/
# Tract-level pilot outputs are partial and regenerated by
# `python3 -m pipeline.pilot`; they are not a committed dataset.
pipeline/pilot_out/
*.zip
*.xlsx
*.parquet

# Transient marketing build artifacts (regenerated by generate_promo_video.py)
marketing/_frames/
marketing/_bed.wav
marketing/*.wav
marketing/*.mp3
marketing/ReplocX_demo_*_narrated.mp4
marketing/captions.srt
